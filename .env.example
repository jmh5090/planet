# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# .env is git-ignored — it's read once by run.sh so you never have to export
# anything in a terminal, and so the double-click launcher works too.

ANTHROPIC_API_KEY=sk-ant-...

# Only needed if you use --notify slack
# SLACK_WEBHOOK_URL=

# Only needed if you use --notify email
# QUERYSCOUT_SMTP_HOST=
# QUERYSCOUT_SMTP_PORT=587
# QUERYSCOUT_SMTP_USER=
# QUERYSCOUT_SMTP_PASSWORD=
# QUERYSCOUT_EMAIL_FROM=
# QUERYSCOUT_EMAIL_TO=
